---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Icon from '../../components/Icon.astro';
import { visible, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const projects = visible(await getCollection('projects'));
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'projects'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<Article
  title={d.title}
  description={d.summary ?? `Project: ${d.title}`}
  section={{ label: 'Projects', href: '/projects' }}
  crumb={d.status}
  date={d.date}
  updated={d.updated}
  readingTime={readingTime(entry.body)}
  summary={d.summary}
  tags={d.tags}
  headings={headings}
  badges={[
    { text: d.status, class: `badge ${d.status === 'shipped' ? '' : 'badge--neutral'}` },
    ...(d.role ? [{ text: d.role }] : []),
  ]}
>
  <Fragment slot="before">
    {d.cover && <img class="article-cover" src={d.cover} alt="" />}

    {
      (d.repo || d.demo) && (
        <p class="article-actions">
          {d.repo && (
            <a class="btn btn--primary" href={d.repo} target="_blank" rel="noopener">
              <Icon name="github" /> Source code
            </a>
          )}
          {d.demo && (
            <a class="btn" href={d.demo} target="_blank" rel="noopener">
              <Icon name="external" /> Live demo
            </a>
          )}
        </p>
      )
    }

    {
      d.results.length > 0 && (
        <div class="callout">
          <p class="callout__title">Results</p>
          <ul>
            {d.results.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      )
    }

    {
      d.stack.length > 0 && (
        <div class="callout callout--plain">
          <p class="callout__title">Stack</p>
          <div class="post-card__tags">
            {d.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      )
    }
  </Fragment>

  <Content />
</Article>
