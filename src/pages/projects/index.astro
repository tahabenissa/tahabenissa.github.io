---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Filterable from '../../components/Filterable.astro';
import Icon from '../../components/Icon.astro';
import { loadCollection, chipList, chipAttr } from '../../lib/content';

const projects = await loadCollection('projects');

/** Featured first, then newest. */
const ordered = [...projects].sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf()
);
const chips = chipList(projects.map((p) => [p.data.status, ...p.data.stack]));
---

<Base
  title="Projects"
  description="Things I have built — what problem each one solves, how it works, the results it produces, and what it does not do."
  bare
>
  <PageHero
    lead="Built"
    accent="Projects"
    subtitle="Each one states the problem, the approach, the numbers, and the limitations."
  />

  <div class="wrap page-body">
    {
      ordered.length === 0 ? (
        <p class="empty">
          No projects published yet. Add a note with <code>published: true</code> under
          <code>Projets/</code> in your vault and run <code>npm run sync</code>.
        </p>
      ) : (
        <Filterable noun={['project', 'projects']} chips={chips} chipsLabel="stack" total={ordered.length}>
          {ordered.map((p) => (
            <PostCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              date={p.data.date}
              summary={p.data.summary}
              tags={p.data.stack}
              linkTags={false}
              tagLimit={5}
              label={p.data.featured ? `${p.data.status} · featured` : p.data.status}
              labelClass={p.data.status === 'shipped' || p.data.featured ? 'tag--accent' : undefined}
              draft={p.data.draft}
              chips={chipAttr([p.data.status, ...p.data.stack])}
            >
              {p.data.results.length > 0 && (
                <ul class="post-card__results">
                  {p.data.results.slice(0, 3).map((r) => <li>{r}</li>)}
                </ul>
              )}
              {(p.data.repo || p.data.demo) && (
                <div class="post-card__links">
                  {p.data.repo && (
                    <a href={p.data.repo} target="_blank" rel="noopener"><Icon name="github" size={14} /> Source</a>
                  )}
                  {p.data.demo && (
                    <a href={p.data.demo} target="_blank" rel="noopener"><Icon name="external" size={14} /> Demo</a>
                  )}
                </div>
              )}
            </PostCard>
          ))}
        </Filterable>
      )
    }
  </div>
</Base>
