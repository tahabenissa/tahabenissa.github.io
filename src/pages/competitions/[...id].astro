---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Facts from '../../components/Facts.astro';
import PostCard from '../../components/PostCard.astro';
import { visible, readingTime, rankClass, ordinal, topPercent } from '../../lib/content';

export async function getStaticPaths() {
  const comps = visible(await getCollection('competitions'));
  return comps.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'competitions'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const pct = topPercent(d.rank, d.totalTeams);

/** Writeups tagged with this event, newest first. */
const writeups = visible(await getCollection('writeups'))
  .filter((w) => w.data.event === d.event)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Article
  title={d.title}
  description={d.summary ?? `Results and writeups from ${d.event}${d.rank ? ` — placed ${ordinal(d.rank)}` : ''}.`}
  section={{ label: 'Competitions', href: '/competitions' }}
  crumb="result"
  date={d.date}
  summary={d.summary}
  tags={d.tags}
  headings={headings}
  badges={[...(d.scope ? [{ text: d.scope }] : []), { text: d.format }]}
>
  <Fragment slot="before">
    {
      d.rank && (
        <div class="stats">
          <div class="stat">
            <div class="stat__num">
              <span class={rankClass(d.rank)}>{ordinal(d.rank)}</span>
            </div>
            <div class="stat__label">{d.totalTeams ? `of ${d.totalTeams} teams` : 'placement'}</div>
          </div>
          {pct && (
            <div class="stat">
              <div class="stat__num">top {pct}%</div>
              <div class="stat__label">percentile</div>
            </div>
          )}
          {d.score !== undefined && (
            <div class="stat">
              <div class="stat__num">{d.score}</div>
              <div class="stat__label">{d.maxScore ? `of ${d.maxScore} points` : 'points'}</div>
            </div>
          )}
          {d.solvedCount !== undefined && (
            <div class="stat">
              <div class="stat__num">{d.solvedCount}</div>
              <div class="stat__label">challenges solved</div>
            </div>
          )}
        </div>
      )
    }

    <Facts
      rows={[
        ['Event', d.event],
        ['Organizer', d.organizer],
        ['Format', d.format],
        ['Scope', d.scope],
        ['Team', d.team ? `${d.team}${d.teamSize ? ` (${d.teamSize} players)` : ''}` : 'Solo'],
        ['Scoreboard', d.url],
      ]}
    />
  </Fragment>

  <Content />

  {
    writeups.length > 0 && (
      <section slot="after" class="related">
        <h2 class="related__title">Writeups from this event <span class="faint mono">{writeups.length}</span></h2>
        <div class="card-grid card-grid--2">
          {writeups.map((w) => (
            <PostCard
              href={`/writeups/${w.id}`}
              title={w.data.title}
              date={w.data.date}
              readingTime={readingTime(w.body)}
              summary={w.data.summary}
              label={w.data.category}
              labelClass={`cat cat-${w.data.category}`}
              meta={
                [w.data.difficulty, w.data.points ? `${w.data.points} pts` : undefined, w.data.timeToFlag]
                  .filter(Boolean)
                  .join(' · ') || undefined
              }
            />
          ))}
        </div>
      </section>
    )
  }
</Article>
