---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { slugifyTag } from '../../lib/content';

type Item = {
  title: string;
  href: string;
  date: Date;
  kind: string;
  summary?: string;
};

// NOTE: getStaticPaths is hoisted out of this module at build time, so it can
// only use its own local scope and imports — no module-level helpers here.
export async function getStaticPaths() {
  const sections: [string, string][] = [
    ['posts', 'post'],
    ['cheatsheets', 'cheatsheet'],
    ['papers', 'paper'],
    ['writeups', 'writeup'],
    ['competitions', 'competition'],
    ['projects', 'project'],
    ['notes', 'note'],
  ];

  const items: (Item & { tags: string[] })[] = [];

  for (const [collection, kind] of sections) {
    const entries = await getCollection(collection as never);
    for (const entry of entries as any[]) {
      if (import.meta.env.PROD && entry.data.draft) continue;
      items.push({
        title: entry.data.title,
        href: `/${collection}/${entry.id}`,
        date: entry.data.date,
        kind,
        summary: entry.data.summary ?? entry.data.verdict,
        tags: entry.data.tags ?? [],
      });
    }
  }

  const groups = new Map<string, { label: string; items: Item[] }>();
  for (const { tags, ...item } of items) {
    for (const tag of tags) {
      const slug = slugifyTag(tag);
      if (!slug) continue;
      if (!groups.has(slug)) groups.set(slug, { label: tag, items: [] });
      groups.get(slug)!.items.push(item);
    }
  }

  return [...groups.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: {
      label: group.label,
      items: group.items.sort((a, b) => b.date.valueOf() - a.date.valueOf()),
    },
  }));
}

const { label, items } = Astro.props as { label: string; items: Item[] };
---

<Base title={`#${label}`} description={`Everything tagged ${label}.`} bare>
  <PageHero
    lead="#"
    accent={label}
    subtitle={`${items.length} ${items.length === 1 ? 'entry' : 'entries'} across the site.`}
  >
    <p class="page-hero__back"><a class="arrow-link" href="/tags">&larr; All tags</a></p>
  </PageHero>

  <div class="wrap page-body">
    <div class="card-grid">
      {
        items.map((item) => (
          <PostCard href={item.href} title={item.title} date={item.date} summary={item.summary} label={item.kind} />
        ))
      }
    </div>
  </div>
</Base>
