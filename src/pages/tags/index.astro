---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { visible, tagCounts, slugifyTag } from '../../lib/content';

const collections = await Promise.all([
  getCollection('papers'),
  getCollection('writeups'),
  getCollection('competitions'),
  getCollection('projects'),
  getCollection('notes'),
]);

const all = collections.flatMap((c) => visible(c as any[]));
const counts = tagCounts(all as { data: { tags?: string[] } }[]);
---

<Base title="Tags" description="Every topic covered on this site." bare>
  <PageHero lead="All" accent="Tags" subtitle={`${counts.length} topics across everything published here.`} />

  <div class="wrap page-body">
    {
      counts.length === 0 ? (
        <p class="empty">No tags yet.</p>
      ) : (
        <div class="tech-row">
          {counts.map(([tag, n]) => (
            <a class="chip chip--outline chip--lg" href={`/tags/${slugifyTag(tag)}`}>
              #{tag} <span class="faint">{n}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>
