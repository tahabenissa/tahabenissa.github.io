---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import Dashboard from '../components/Dashboard.astro';
import { SITE } from '../config';
import { loadCollection, readingTime, tagCounts, slugifyTag, ordinal, topPercent } from '../lib/content';

const [papers, writeups, competitions, projects, notes] = await Promise.all([
  loadCollection('papers'),
  loadCollection('writeups'),
  loadCollection('competitions'),
  loadCollection('projects'),
  loadCollection('notes'),
]);

/** One flat, dated stream across every section — the dashboard's raw input. */
const activity = [
  ...writeups.map((e) => ({ section: 'writeups' as const, date: e.data.date, title: e.data.title, id: e.id })),
  ...papers.map((e) => ({ section: 'papers' as const, date: e.data.date, title: e.data.title, id: e.id })),
  ...notes.map((e) => ({ section: 'notes' as const, date: e.data.date, title: e.data.title, id: e.id })),
  ...projects.map((e) => ({ section: 'projects' as const, date: e.data.date, title: e.data.title, id: e.id })),
  ...competitions.map((e) => ({ section: 'competitions' as const, date: e.data.date, title: e.data.event, id: e.id })),
];

const sectionCounts = {
  writeups: writeups.length,
  papers: papers.length,
  notes: notes.length,
  projects: projects.length,
  competitions: competitions.length,
};

/** Reuse the tag counter — a category is just a one-item tag list. */
const writeupCategories = tagCounts(writeups.map((w) => ({ data: { tags: [w.data.category] } })));

const compRows = competitions.map((c) => ({
  id: c.id,
  event: c.data.event,
  date: c.data.date,
  rank: c.data.rank,
  totalTeams: c.data.totalTeams,
}));

/** The "latest" grid: every section in one stream, newest first. */
type Latest = {
  href: string;
  title: string;
  date: Date;
  summary?: string;
  tags: string[];
  label: string;
  labelClass?: string;
  readingTime?: string;
  meta?: string;
};

const latest: Latest[] = [
  ...writeups.map((w) => ({
    href: `/writeups/${w.id}`,
    title: w.data.title,
    date: w.data.date,
    summary: w.data.summary,
    tags: w.data.tags,
    label: `writeup · ${w.data.category}`,
    labelClass: `cat cat-${w.data.category}`,
    readingTime: readingTime(w.body),
    meta: [w.data.platform, w.data.difficulty].filter(Boolean).join(' · ') || undefined,
  })),
  ...notes.map((n) => ({
    href: `/notes/${n.id}`,
    title: n.data.title,
    date: n.data.date,
    summary: n.data.summary,
    tags: n.data.tags,
    label: n.data.kind === 'reflex' ? 'reflex' : n.data.kind === 'deep-dive' ? 'deep dive' : 'note',
    labelClass: n.data.topic ? `cat cat-${n.data.topic}` : undefined,
    readingTime: readingTime(n.body),
  })),
  ...papers.map((p) => ({
    href: `/papers/${p.id}`,
    title: p.data.title,
    date: p.data.date,
    summary: p.data.verdict ?? p.data.summary,
    tags: p.data.tags,
    label: 'paper',
    readingTime: readingTime(p.body),
    meta: p.data.venue,
  })),
  ...projects.map((p) => ({
    href: `/projects/${p.id}`,
    title: p.data.title,
    date: p.data.date,
    summary: p.data.summary,
    tags: [...p.data.stack],
    label: `project · ${p.data.status}`,
    readingTime: readingTime(p.body),
  })),
  ...competitions.map((c) => {
    const pct = topPercent(c.data.rank, c.data.totalTeams);
    return {
      href: `/competitions/${c.id}`,
      title: c.data.event,
      date: c.data.date,
      summary: c.data.summary,
      tags: c.data.tags,
      label: 'competition',
      meta: c.data.rank
        ? `${ordinal(c.data.rank)}${c.data.totalTeams ? ` / ${c.data.totalTeams}` : ''}${pct ? ` · top ${pct}%` : ''}`
        : undefined,
    };
  }),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 6);

const everything = [...papers, ...writeups, ...competitions, ...projects, ...notes];
const topTags = tagCounts(everything as { data: { tags?: string[] } }[]).slice(0, 6).map(([t]) => t);

const socials = [
  SITE.links.github && { icon: 'github' as const, href: SITE.links.github, label: 'GitHub' },
  SITE.links.linkedin && { icon: 'linkedin' as const, href: SITE.links.linkedin, label: 'LinkedIn' },
  { icon: 'mail' as const, href: `mailto:${SITE.author.email}`, label: 'Email' },
].filter(Boolean) as { icon: 'github' | 'linkedin' | 'mail'; href: string; label: string }[];
---

<Base bare>
  <!-- ============================== Hero ============================== -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="hero__inner wrap">
      <h1 class="hero__title">
        <span class="hero__hello">Hello, I'm</span>
        <span class="typewriter" data-words={JSON.stringify(SITE.typewriter)}>
          <span class="typewriter__glow" aria-hidden="true"></span>
          <span class="typewriter__text">{SITE.typewriter[0]}</span><span class="typewriter__caret" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="hero__role">{SITE.role}</p>
      <p class="hero__bio">{SITE.author.bio}</p>

      {
        topTags.length > 0 && (
          <div class="hero__tags">
            {topTags.map((tag) => (
              <a class="chip chip--outline chip--lg" href={`/tags/${slugifyTag(tag)}`}>#{tag}</a>
            ))}
          </div>
        )
      }

      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="/notes">
          Boot Sequence <Icon name="arrowRight" size={20} />
        </a>
        <a class="btn btn--lg" href="/about">
          <Icon name="terminal" size={20} /> <span class="mono">`whoami`</span>
        </a>
      </div>

      <div class="socials socials--hero">
        {
          socials.map((s) => (
            <a
              class="social"
              href={s.href}
              title={s.label}
              aria-label={s.label}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'me noopener' : undefined}
            >
              <Icon name={s.icon} size={20} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true"></div>
  </section>

  <!-- ========================= Latest content ========================= -->
  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <div>
          <h2 class="band-title">Incoming Transmissions</h2>
          <p class="band-sub">Recent writeups, deep dives, reading notes and projects.</p>
        </div>
        <a class="arrow-link" href="/notes">
          Read all notes <Icon name="arrowRight" />
        </a>
      </div>

      {
        latest.length > 0 ? (
          <div class="card-grid" data-reveal>
            {latest.map((item) => (
              <PostCard
                href={item.href}
                title={item.title}
                date={item.date}
                readingTime={item.readingTime}
                summary={item.summary}
                tags={item.tags}
                label={item.label}
                labelClass={item.labelClass}
                meta={item.meta}
              />
            ))}
          </div>
        ) : (
          <p class="empty">
            Nothing published yet. Mark a note <code>published: true</code> in your vault.
          </p>
        )
      }
    </div>
  </section>

  <!-- ============================ Activity ============================ -->
  <section class="band band--border">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <div>
          <h2 class="band-title">System Telemetry</h2>
          <p class="band-sub">What I've been publishing, month by month.</p>
        </div>
      </div>
      <Dashboard
        items={activity}
        counts={sectionCounts}
        writeupCategories={writeupCategories}
        competitions={compRows}
      />
    </div>
  </section>

  <!-- ============================ Contact ============================= -->
  <section class="band band--border connect">
    <div class="wrap connect__inner" data-reveal>
      <div class="connect__icon"><Icon name="network" size={32} /></div>
      <h2 class="band-title">Establish Connection</h2>
      <p class="band-sub">
        Want to team up for a CTF, talk about a paper, or discuss detection engineering? My comms are open.
      </p>
      <a class="btn btn--invert btn--xl" href={`mailto:${SITE.author.email}`}>
        <Icon name="mail" size={20} /> Initialize Contact
      </a>
    </div>
  </section>
</Base>

<script>
  // Type out each word, pause, erase, move on. Reduced-motion visitors get
  // the first word, static — which is also what the HTML ships with.
  const root = document.querySelector<HTMLElement>('.typewriter');
  const out = root?.querySelector<HTMLElement>('.typewriter__text');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && out && !reduced) {
    const words: string[] = JSON.parse(root.dataset.words ?? '[]');
    let word = 0;
    let text = words[0] ?? '';
    let deleting = false;

    const tick = () => {
      const full = words[word];
      if (deleting) {
        text = full.slice(0, text.length - 1);
        if (!text) {
          deleting = false;
          word = (word + 1) % words.length;
          out.textContent = text;
          return setTimeout(tick, 500);
        }
        out.textContent = text;
        return setTimeout(tick, 50);
      }
      text = full.slice(0, text.length + 1);
      out.textContent = text;
      if (text === full) {
        deleting = true;
        return setTimeout(tick, 3000);
      }
      return setTimeout(tick, 100);
    };

    if (words.length > 1) setTimeout(() => { deleting = true; tick(); }, 3000);
  }
</script>
