---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Filterable from '../../components/Filterable.astro';
import { loadCollection, readingTime, chipList, chipAttr } from '../../lib/content';

const notes = await loadCollection('notes');

const kindLabel = { reflex: 'reflex', 'deep-dive': 'deep dive', note: 'note' } as const;
const chips = chipList(notes.map((n) => [kindLabel[n.data.kind], n.data.topic ?? '', ...n.data.tags]));
---

<Base
  title="Notes"
  description="Technical notes: how a class of vulnerability actually works, and the first moves when I meet one under time pressure."
  bare
>
  <PageHero
    lead="All"
    accent="Notes"
    subtitle={`${notes.length} ${notes.length === 1 ? 'note' : 'notes'}. Deep dives explain a mechanism properly; reflexes are the first-moves lists I reach for when a clock is running.`}
  />

  <div class="wrap page-body">
    {
      notes.length === 0 ? (
        <p class="empty">
          Nothing published yet. Add <code>published: true</code> to a note in
          <code>explanations/</code> or <code>CTF/03-Reflexes/</code> and run <code>npm run sync</code>.
        </p>
      ) : (
        <Filterable noun={['note', 'notes']} chips={chips} total={notes.length}>
          {notes.map((n) => (
            <PostCard
              href={`/notes/${n.id}`}
              title={n.data.title}
              date={n.data.date}
              readingTime={readingTime(n.body)}
              summary={n.data.summary}
              tags={n.data.tags}
              label={n.data.topic ? `${n.data.topic} · ${kindLabel[n.data.kind]}` : kindLabel[n.data.kind]}
              labelClass={n.data.topic ? `cat cat-${n.data.topic}` : undefined}
              draft={n.data.draft}
              chips={chipAttr([kindLabel[n.data.kind], n.data.topic, ...n.data.tags])}
            />
          ))}
        </Filterable>
      )
    }
  </div>
</Base>
