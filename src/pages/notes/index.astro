---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Filterable from '../../components/Filterable.astro';
import { loadCollection, readingTime, chipList, chipAttr, levelCounts } from '../../lib/content';

const notes = await loadCollection('notes');

const kindLabel = { reflex: 'reflex', 'deep-dive': 'deep dive', note: 'note' } as const;
const chips = chipList(
  notes.map((n) => [n.data.topic ?? '', n.data.type ?? '', kindLabel[n.data.kind], ...n.data.tags])
);
---

<Base
  title="Study Notes"
  description="Study notes on malware analysis, reverse engineering and Windows internals — filter them by level, from beginner to advanced."
  bare
>
  <PageHero
    lead="Study"
    accent="Notes"
    subtitle={`${notes.length} ${notes.length === 1 ? 'note' : 'notes'} from courses, books and labs. Filter by level, or sort from easy to hard.`}
  />

  <div class="wrap page-body">
    {
      notes.length === 0 ? (
        <p class="empty">
          Nothing published yet. Write a note in <code>Website/Notes/</code> and run
          <code>npm run publish</code>.
        </p>
      ) : (
        <Filterable noun={['note', 'notes']} chips={chips} total={notes.length} levels levelCounts={levelCounts(notes)}>
          {notes.map((n) => (
            <PostCard
              href={`/notes/${n.id}`}
              title={n.data.title}
              date={n.data.date}
              readingTime={readingTime(n.body)}
              summary={n.data.summary}
              tags={n.data.tags}
              level={n.data.level}
              label={[n.data.topic, n.data.type ?? kindLabel[n.data.kind]].filter(Boolean).join(' · ')}
              labelClass={n.data.topic ? `cat cat-${n.data.topic}` : undefined}
              meta={n.data.reference}
              draft={n.data.draft}
              chips={chipAttr([n.data.topic, n.data.type, kindLabel[n.data.kind], ...n.data.tags])}
            />
          ))}
        </Filterable>
      )
    }
  </div>
</Base>
