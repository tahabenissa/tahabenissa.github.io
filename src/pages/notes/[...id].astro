---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { visible, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const notes = visible(await getCollection('notes'));
  return notes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'notes'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const kind = d.kind === 'deep-dive' ? 'deep dive' : d.kind;
---

<Article
  title={d.title}
  description={d.summary ?? `Note: ${d.title}`}
  section={{ label: 'Notes', href: '/notes' }}
  crumb={kind}
  date={d.date}
  updated={d.updated}
  readingTime={readingTime(entry.body)}
  summary={d.summary}
  tags={d.tags}
  headings={headings}
  badges={[
    ...(d.topic ? [{ text: d.topic, class: `tag cat cat-${d.topic}` }] : []),
    ...(d.draft ? [{ text: 'draft', class: 'badge badge--warn' }] : []),
  ]}
>
  <Content />
</Article>
