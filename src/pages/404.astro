---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" narrow>
  <div class="page-head">
    <p class="eyebrow">404</p>
    <h1>That page does not exist</h1>
    <p class="lede">
      The link may be stale, or the note may not be published yet.
    </p>
  </div>
  <div class="hero__links" style="margin-top:0">
    <a class="btn btn--primary" href="/">Home</a>
    <a class="btn" href="/writeups">Writeups</a>
    <a class="btn" href="/papers">Papers</a>
  </div>
</Base>
