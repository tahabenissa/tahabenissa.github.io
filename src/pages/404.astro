---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found" bare>
  <section class="hero hero--short">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero__inner wrap">
      <p class="mono faint">$ cat {Astro.url.pathname}</p>
      <h1 class="hero__title"><span class="accent">404</span></h1>
      <p class="hero__role">No such file or directory</p>
      <p class="hero__bio">The link may be stale, or the note may not be published yet.</p>
      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="/"><Icon name="terminal" size={20} /> cd ~</a>
        <a class="btn btn--lg" href="/writeups">Writeups</a>
        <a class="btn btn--lg" href="/notes">Notes</a>
      </div>
    </div>
  </section>
</Base>
