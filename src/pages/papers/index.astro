---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Filterable from '../../components/Filterable.astro';
import { loadCollection, readingTime, chipList, chipAttr } from '../../lib/content';

const papers = await loadCollection('papers');
const chips = chipList(papers.map((p) => p.data.tags));

const byline = (authors: readonly string[]) =>
  authors.length ? `${authors[0]}${authors.length > 1 ? ' et al.' : ''}` : undefined;
---

<Base
  title="Papers"
  description="Security and machine-learning papers I have read, with my notes on each one: what problem it solves, how, and whether the evaluation holds up."
  bare
>
  <PageHero
    lead="Reading"
    accent="Notes"
    subtitle={`${papers.length} ${papers.length === 1 ? 'paper' : 'papers'} read properly — the problem, the contribution, the evaluation, and what I would question.`}
  />

  <div class="wrap page-body">
    {
      papers.length === 0 ? (
        <p class="empty">
          Nothing published yet. Add <code>published: true</code> to a note in
          <code>Recherche/02-Notes-de-Lecture/</code> and run <code>npm run sync</code>.
        </p>
      ) : (
        <Filterable noun={['paper', 'papers']} chips={chips} total={papers.length}>
          {papers.map((p) => (
            <PostCard
              href={`/papers/${p.id}`}
              title={p.data.title}
              date={p.data.date}
              readingTime={readingTime(p.body)}
              summary={p.data.verdict ?? p.data.summary}
              tags={p.data.tags}
              label={p.data.pass ? `paper · pass ${p.data.pass}` : 'paper'}
              meta={[p.data.venue, byline(p.data.authors)].filter(Boolean).join(' · ') || undefined}
              draft={p.data.draft}
              chips={chipAttr(p.data.tags)}
            />
          ))}
        </Filterable>
      )
    }
  </div>
</Base>
