---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Tags from '../../components/Tags.astro';
import { visible, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const papers = visible(await getCollection('papers'));
  return papers.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'papers'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const authorLine =
  d.authors.length > 3 ? `${d.authors.slice(0, 3).join(', ')} et al.` : d.authors.join(', ');
---

<Base title={d.title} description={d.summary ?? d.verdict ?? `Reading notes on ${d.title}`} narrow>
  <p class="eyebrow"><a href="/papers" style="color:inherit;text-decoration:none">Papers</a> / note</p>

  <div class="article-head">
    <h1>{d.title}</h1>
    <div class="article-meta">
      <span><time datetime={isoDate(d.date)}>Read {formatDate(d.date)}</time></span>
      {d.updated && <span>updated {formatDate(d.updated)}</span>}
      {d.pass && <span>pass {d.pass}</span>}
      {d.draft && <span class="badge badge--warn">draft</span>}
    </div>
  </div>

  {d.verdict && <p class="lede" style="margin-bottom:1.75rem">{d.verdict}</p>}

  <Facts
    rows={[
      ['Authors', authorLine],
      ['Venue', d.venue],
      ['Year', d.year],
      ['Reading pass', d.pass ? `${d.pass} of 3` : undefined],
      ['Related course', d.relatedCourse],
      ['Paper', d.link],
    ]}
  />

  {
    d.link && (
      <p style="margin-top:-1.25rem;margin-bottom:2rem">
        <a class="btn" href={d.link} target="_blank" rel="noopener">
          Read the paper &nearr;
        </a>
      </p>
    )
  }

  {
    headings.filter((h) => h.depth === 2).length > 2 && (
      <nav class="facts-wrap" style="padding:1rem 1.2rem" aria-label="On this page">
        <p class="eyebrow" style="margin-bottom:.5rem">On this page</p>
        <ul style="margin:0;padding-left:1.1rem;font-size:.875rem">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
        </ul>
      </nav>
    )
  }

  <article class="prose">
    <Content />
  </article>

  {
    d.tags.length > 0 && (
      <footer style="margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--border)">
        <p class="eyebrow">Tags</p>
        <Tags tags={d.tags} />
      </footer>
    )
  }
</Base>
