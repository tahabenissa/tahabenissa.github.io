---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Facts from '../../components/Facts.astro';
import Icon from '../../components/Icon.astro';
import { visible, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const papers = visible(await getCollection('papers'));
  return papers.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'papers'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const authorLine =
  d.authors.length > 3 ? `${d.authors.slice(0, 3).join(', ')} et al.` : d.authors.join(', ');
---

<Article
  title={d.title}
  description={d.summary ?? d.verdict ?? `Reading notes on ${d.title}`}
  section={{ label: 'Papers', href: '/papers' }}
  crumb="reading note"
  date={d.date}
  datePrefix="Read"
  updated={d.updated}
  readingTime={readingTime(entry.body)}
  summary={d.verdict ?? d.summary}
  tags={d.tags}
  headings={headings}
  badges={[
    ...(d.pass ? [{ text: `pass ${d.pass}` }] : []),
    ...(d.draft ? [{ text: 'draft', class: 'badge badge--warn' }] : []),
  ]}
>
  <Fragment slot="before">
    <Facts
      rows={[
        ['Authors', authorLine],
        ['Venue', d.venue],
        ['Year', d.year],
        ['Reading pass', d.pass ? `${d.pass} of 3` : undefined],
        ['Related course', d.relatedCourse],
      ]}
    />
    {
      d.link && (
        <p class="article-actions">
          <a class="btn btn--primary" href={d.link} target="_blank" rel="noopener">
            Read the paper <Icon name="external" />
          </a>
        </p>
      )
    }
  </Fragment>

  <Content />
</Article>
