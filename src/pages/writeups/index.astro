---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Filterable from '../../components/Filterable.astro';
import { loadCollection, readingTime, chipList, chipAttr } from '../../lib/content';

const writeups = await loadCollection('writeups');

const platforms = [...new Set(writeups.map((w) => w.data.platform).filter(Boolean))] as string[];
const chips = chipList(writeups.map((w) => [w.data.category, ...w.data.tags]));
---

<Base
  title="Writeups"
  description="CTF challenge and machine writeups: recon, the idea that cracked it, the exploit, and what I would do faster next time."
  bare
>
  <PageHero
    lead="CTF"
    accent="Writeups"
    subtitle={`${writeups.length} ${writeups.length === 1 ? 'writeup' : 'writeups'}${
      platforms.length ? ` across ${platforms.join(', ')}` : ''
    } — how I actually solved things, dead ends included.`}
  />

  <div class="wrap page-body">
    {
      writeups.length === 0 ? (
        <p class="empty">
          Nothing published yet. Add <code>published: true</code> to a writeup in
          <code>CTF/01-Writeups/</code> and run <code>npm run sync</code>.
        </p>
      ) : (
        <Filterable noun={['writeup', 'writeups']} chips={chips} total={writeups.length}>
          {writeups.map((w) => (
            <PostCard
              href={`/writeups/${w.id}`}
              title={w.data.title}
              date={w.data.date}
              readingTime={readingTime(w.body)}
              summary={w.data.summary}
              tags={w.data.techniques.length ? w.data.techniques : w.data.tags}
              linkTags={!w.data.techniques.length}
              label={w.data.category}
              labelClass={`cat cat-${w.data.category}`}
              meta={
                [
                  w.data.platform,
                  w.data.event,
                  w.data.difficulty,
                  w.data.points ? `${w.data.points} pts` : undefined,
                  w.data.solved ? undefined : 'unsolved',
                ]
                  .filter(Boolean)
                  .join(' · ') || undefined
              }
              draft={w.data.draft}
              chips={chipAttr([w.data.category, ...w.data.tags])}
            />
          ))}
        </Filterable>
      )
    }
  </div>
</Base>
