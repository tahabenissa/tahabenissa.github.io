---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Tags from '../../components/Tags.astro';
import { visible, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const writeups = visible(await getCollection('writeups'));
  return writeups.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'writeups'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/** Link a writeup back to the competition it was solved in. */
const comps = visible(await getCollection('competitions'));
const parent = d.event ? comps.find((c) => c.data.event === d.event) : undefined;
---

<Base title={d.title} description={d.summary ?? `CTF writeup: ${d.title}`} narrow>
  <p class="eyebrow">
    <a href="/writeups" style="color:inherit;text-decoration:none">Writeups</a> / {d.category}
  </p>

  <div class="article-head">
    <h1>{d.title}</h1>
    <div class="article-meta">
      <span><time datetime={isoDate(d.date)}>{formatDate(d.date)}</time></span>
      <span class={`tag cat cat-${d.category}`}>{d.category}</span>
      {d.difficulty && <span>{d.difficulty}</span>}
      {!d.solved && <span class="badge badge--warn">unsolved</span>}
      {d.draft && <span class="badge badge--neutral">draft</span>}
    </div>
  </div>

  {d.summary && <p class="lede" style="margin-bottom:1.75rem">{d.summary}</p>}

  <Facts
    rows={[
      ['Platform', d.platform],
      ['Event', parent ? undefined : d.event],
      ['Category', d.category],
      ['Difficulty', d.difficulty],
      ['Points', d.points || undefined],
      ['Time to flag', d.timeToFlag],
      ['Techniques', d.techniques],
    ]}
  />

  {
    parent && (
      <p style="margin-top:-1.25rem;margin-bottom:2rem">
        <a class="btn" href={`/competitions/${parent.id}`}>
          &larr; Solved during {parent.data.event}
        </a>
      </p>
    )
  }

  <article class="prose">
    <Content />
  </article>

  {
    d.tags.length > 0 && (
      <footer style="margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--border)">
        <p class="eyebrow">Tags</p>
        <Tags tags={d.tags} />
      </footer>
    )
  }
</Base>
