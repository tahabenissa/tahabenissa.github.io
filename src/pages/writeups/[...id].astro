---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Facts from '../../components/Facts.astro';
import Icon from '../../components/Icon.astro';
import { visible, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const writeups = visible(await getCollection('writeups'));
  return writeups.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'writeups'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

/** Link a writeup back to the competition it was solved in. */
const comps = visible(await getCollection('competitions'));
const parent = d.event ? comps.find((c) => c.data.event === d.event) : undefined;
---

<Article
  title={d.title}
  description={d.summary ?? `CTF writeup: ${d.title}`}
  section={{ label: 'Writeups', href: '/writeups' }}
  crumb={d.category}
  date={d.date}
  updated={d.updated}
  readingTime={readingTime(entry.body)}
  summary={d.summary}
  tags={d.tags}
  headings={headings}
  badges={[
    { text: d.category, class: `tag cat cat-${d.category}` },
    ...(d.difficulty ? [{ text: d.difficulty }] : []),
    ...(!d.solved ? [{ text: 'unsolved', class: 'badge badge--warn' }] : []),
    ...(d.draft ? [{ text: 'draft', class: 'badge badge--neutral' }] : []),
  ]}
>
  <Fragment slot="before">
    <Facts
      rows={[
        ['Platform', d.platform],
        ['Event', parent ? undefined : d.event],
        ['Category', d.category],
        ['Difficulty', d.difficulty],
        ['Points', d.points || undefined],
        ['Time to flag', d.timeToFlag],
        ['Techniques', d.techniques],
      ]}
    />
    {
      parent && (
        <p class="article-actions">
          <a class="btn" href={`/competitions/${parent.id}`}>
            <Icon name="trophy" /> Solved during {parent.data.event}
          </a>
        </p>
      )
    }
  </Fragment>

  <Content />
</Article>
