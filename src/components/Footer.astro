---
import { SITE } from '../config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const handle = SITE.handle.prefix + SITE.handle.initial + SITE.handle.rest;
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="socials">
      {SITE.links.github && (
        <a class="social" href={SITE.links.github} target="_blank" rel="me noopener" title="GitHub" aria-label="GitHub">
          <Icon name="github" size={18} />
        </a>
      )}
      {SITE.links.linkedin && (
        <a class="social" href={SITE.links.linkedin} target="_blank" rel="me noopener" title="LinkedIn" aria-label="LinkedIn">
          <Icon name="linkedin" size={18} />
        </a>
      )}
      <a class="social" href={`mailto:${SITE.author.email}`} title="Email" aria-label="Email">
        <Icon name="mail" size={18} />
      </a>
      <a class="social" href="/rss.xml" title="RSS feed" aria-label="RSS feed">
        <Icon name="rss" size={18} />
      </a>
    </div>
    <p>
      Built with love.
      <span class="accent mono">{handle}</span> &copy; {year}
    </p>
    <p class="faint small">Written in Obsidian, published with Astro.</p>
  </div>
</footer>
