---
import { SITE } from '../config';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

/** '/papers/foo' should still light up the Papers link. */
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.title} — home`}>
      <Icon name="terminal" size={22} class="brand__icon" />
      <span class="brand__text">
        {SITE.handle.prefix}<span class="accent">{SITE.handle.initial}</span><span class="brand__rest">{SITE.handle.rest}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-btn hide-sm" href="/rss.xml" title="RSS feed" aria-label="RSS feed">
        <Icon name="rss" />
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle colour theme">
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={20} class="icon-open" />
        <Icon name="x" size={20} class="icon-close" />
      </button>
    </div>
  </div>

  <nav class="mobile-nav wrap" id="mobile-nav" aria-label="Main" hidden>
    {
      SITE.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href="/rss.xml"><Icon name="rss" /> RSS Feed</a>
  </nav>
</header>
