---
import { SITE } from '../config';

const path = Astro.url.pathname;
const initials = SITE.author.name
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

/** '/papers/foo' should still light up the Papers link. */
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      {/* Initials sit behind the photo; a missing file removes the img and
          reveals them, so the mark never renders as a broken image. */}
      <span class="brand__mark" aria-hidden="true">
        <span class="brand__initials">{initials}</span>
        {SITE.author.avatar && <img src={SITE.author.avatar} alt="" onerror="this.remove()" />}
      </span>
      {SITE.title}
    </a>

    <nav class="nav" aria-label="Main">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle colour theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>
